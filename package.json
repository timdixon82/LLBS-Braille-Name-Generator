{
  "name": "llbs-braille-name-generator",
  "version": "0.0.0",
  "description": "LLBS Braille Name Generator — create and share a Grade 1 braille image of a name.",
  "private": true,
  "type": "module",
  "scripts": {
    "lint:html": "html-validate index.html",
    "lint:css": "stylelint \"styles/**/*.css\"",
    "lint:js": "eslint \"scripts/**/*.js\"",
    "lint": "npm run lint:html && npm run lint:css && npm run lint:js",
    "test": "vitest run"
  },
  "devDependencies": {
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "html-validate": "^11.17.0",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "vitest": "^5.0.5"
  }
}
